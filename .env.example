GEMINI_API_KEY=
YOUTUBE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# true = research 'overall' only (fits a restrictive free-tier Gemini quota); false = all 6 categories too
GEMINI_FREE_TIER_MODE=true
# Client-safe (exposed to the browser) — used for user auth, distinct from the service_role key above
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Any random string. Once set, Vercel automatically sends it as a Bearer token on Cron requests
# to /api/cron/weekly, which the route checks to reject unauthorized callers.
CRON_SECRET=
